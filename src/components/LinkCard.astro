---
import type { LinkItem } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  link: LinkItem;
}

const { link } = Astro.props;
const isExternal = link.href.startsWith('http');
---

<a
  href={link.href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="group grid min-h-15 grid-cols-[1.5rem_1fr_1.5rem] items-center gap-3 rounded-xl border border-line bg-surface px-4 py-2.5 transition-[background-color,border-color,transform] duration-150 hover:border-accent/35 hover:bg-surface-hover active:scale-[0.99] focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none motion-reduce:transition-none sm:px-5"
>
  <Icon
    name={link.icon}
    class="size-5 text-ink-muted transition-colors duration-150 group-hover:text-accent motion-reduce:transition-none"
  />
  <span class="truncate text-center text-base font-medium text-ink">{link.label}</span>
  <Icon
    name="arrow-up-right"
    class="size-[18px] justify-self-end text-ink-muted transition-[color,transform] duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent motion-reduce:transition-none"
  />
  {isExternal && <span class="sr-only">(opens in a new tab)</span>}
</a>
