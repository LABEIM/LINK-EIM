---
import type { LinkItem } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  link: LinkItem;
}

const { link } = Astro.props;
const isExternal = link.href.startsWith('http');
---

<a
  href={link.href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="group -mx-3 flex min-h-14 items-center gap-4 border-b border-line px-3 py-3.5 transition-[background-color,transform] duration-150 hover:bg-surface active:translate-y-px active:bg-surface focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset focus-visible:outline-none motion-reduce:transition-none"
>
  <Icon
    name={link.icon}
    class="size-[18px] shrink-0 text-ink-muted transition-colors duration-150 group-hover:text-accent motion-reduce:transition-none"
  />
  <span class="min-w-0 flex-1">
    <span class="block text-base leading-snug font-medium text-ink">{link.label}</span>
    {link.description && (
      <span class="mt-0.5 block text-[13px] leading-relaxed text-ink-muted">
        {link.description}
      </span>
    )}
  </span>
  <Icon
    name="arrow-up-right"
    class="size-4 shrink-0 text-ink-muted transition-[color,transform] duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent motion-reduce:transition-none"
  />
  {isExternal && <span class="sr-only">(opens in a new tab)</span>}
</a>
