---
import type { LinkItem } from '../data/site';
import Icon from './Icon.astro';
import IconView from './IconView.astro';

interface Props {
  link: LinkItem;
  priority?: boolean;
}

const { link, priority = false } = Astro.props;
const image = link.image;
const isExternal = link.href.startsWith('http');

const focus =
  'focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none';
const motion = 'transition-[background-color,transform] duration-150 motion-reduce:transition-none';
---

{
  image ? (
    <a
      href={link.href}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      class:list={[
        'group flex h-full flex-col overflow-hidden rounded-xl bg-surface hover:bg-surface-hover active:scale-[0.99]',
        focus,
        motion,
      ]}
    >
      <div class="aspect-video w-full overflow-hidden bg-canvas">
        <img
          src={image.src}
          alt={image.alt}
          width="1200"
          height="675"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none"
        />
      </div>
      <div class="flex flex-1 flex-col px-4 pt-3 pb-3.5">
        <div class="grid min-h-6 grid-cols-[1.25rem_1fr_1.25rem] items-center gap-2.5">
          <IconView
            icon={link.icon}
            customIcon={link.customIcon}
            image={link.iconImage}
            class="size-4 text-ink-muted transition-colors duration-150 group-hover:text-accent motion-reduce:transition-none"
          />
          <span class="line-clamp-2 text-center text-[15px] leading-snug font-medium text-ink">
            {link.label}
          </span>
          <Icon
            name="arrow-up-right"
            class="size-4 justify-self-end text-ink-muted transition-[color,transform] duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent motion-reduce:transition-none"
          />
        </div>
        {link.description && (
          <p class="mt-1.5 line-clamp-2 text-center text-[13px] leading-snug text-ink-muted">
            {link.description}
          </p>
        )}
      </div>
      {isExternal && <span class="sr-only">(opens in a new tab)</span>}
    </a>
  ) : (
    <a
      href={link.href}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      class:list={[
        'group grid min-h-15 grid-cols-[1.5rem_1fr_1.5rem] items-center gap-3 rounded-xl px-4 py-2.5 active:scale-[0.99] sm:px-5',
        link.highlight
          ? 'bg-surface-hover hover:bg-surface-strong'
          : 'bg-surface hover:bg-surface-hover',
        focus,
        motion,
      ]}
    >
      <IconView
        icon={link.icon}
        customIcon={link.customIcon}
        image={link.iconImage}
        class:list={[
          'size-5 transition-colors duration-150 group-hover:text-accent motion-reduce:transition-none',
          link.highlight ? 'text-accent' : 'text-ink-muted',
        ]}
      />
      <span class="flex min-w-0 flex-col items-center justify-center gap-0.5 text-center">
        <span
          class:list={[
            'line-clamp-2 text-balance text-base leading-snug text-ink',
            link.highlight ? 'font-semibold' : 'font-medium',
          ]}
        >
          {link.label}
        </span>
        {link.description && (
          <span class="line-clamp-2 text-[13px] leading-snug text-ink-muted">
            {link.description}
          </span>
        )}
      </span>
      <Icon
        name="arrow-up-right"
        class:list={[
          'size-[18px] justify-self-end transition-[color,transform] duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent motion-reduce:transition-none',
          link.highlight ? 'text-accent' : 'text-ink-muted',
        ]}
      />
      {isExternal && <span class="sr-only">(opens in a new tab)</span>}
    </a>
  )
}
