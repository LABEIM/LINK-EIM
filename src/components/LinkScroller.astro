---
import LinkCard from './LinkCard.astro';
import Icon from './Icon.astro';
import type { LinkGroup } from '../data/site';

interface Props {
  group: LinkGroup;
  labelledBy: string;
  priorityFirst?: boolean;
}

const { group, labelledBy, priorityFirst = false } = Astro.props;
---

<div class="relative mt-3" data-scroller>
  <ul
    data-scroll-track
    tabindex="0"
    aria-labelledby={labelledBy}
    class="flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 [scrollbar-width:none] focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none [&::-webkit-scrollbar]:hidden"
  >
    {
      group.links.map((link, index) => (
        <li class="w-[78%] shrink-0 snap-start sm:w-[56%]">
          <LinkCard link={link} priority={priorityFirst && index === 0} />
        </li>
      ))
    }
  </ul>

  <div data-scroll-controls hidden class="pointer-events-none absolute inset-0">
    <button
      type="button"
      data-scroll-prev
      aria-label={`Scroll ${group.title} left`}
      class="pointer-events-auto absolute top-[32%] left-1 inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-canvas/55 text-ink transition-[background-color,opacity] duration-150 hover:bg-canvas/80 focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none disabled:pointer-events-none disabled:opacity-0 motion-reduce:transition-none"
    >
      <Icon name="chevron-left" class="size-5" />
    </button>
    <button
      type="button"
      data-scroll-next
      aria-label={`Scroll ${group.title} right`}
      class="pointer-events-auto absolute top-[32%] right-1 inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-canvas/55 text-ink transition-[background-color,opacity] duration-150 hover:bg-canvas/80 focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none disabled:pointer-events-none disabled:opacity-0 motion-reduce:transition-none"
    >
      <Icon name="chevron-right" class="size-5" />
    </button>
  </div>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const scroller of document.querySelectorAll<HTMLElement>('[data-scroller]')) {
    const track = scroller.querySelector<HTMLElement>('[data-scroll-track]');
    const controls = scroller.querySelector<HTMLElement>('[data-scroll-controls]');
    const prev = scroller.querySelector<HTMLButtonElement>('[data-scroll-prev]');
    const next = scroller.querySelector<HTMLButtonElement>('[data-scroll-next]');
    if (!track || !controls || !prev || !next) continue;

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const overflows = max > 4;
      controls.hidden = !overflows;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    const step = () => Math.max(track.clientWidth * 0.8, 220);
    const scroll = (direction: 1 | -1) => {
      track.scrollBy({
        left: direction * step(),
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    };

    prev.addEventListener('click', () => scroll(-1));
    next.addEventListener('click', () => scroll(1));
    track.addEventListener('scroll', update, { passive: true });

    new ResizeObserver(update).observe(track);
    update();
  }
</script>
