---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import IconView from '../components/IconView.astro';
import LinkCard from '../components/LinkCard.astro';
import LinkScroller from '../components/LinkScroller.astro';
import { site, linkGroups } from '../data/site';
import { socialLabels } from '../data/icons';

const siteUrl = Astro.site ?? new URL('https://link.eimlab.org');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/assets/logo-icon.png', siteUrl).href;
const shareHost = new URL(site.url).host;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.fullName,
  alternateName: site.name,
  url: site.labUrl,
  logo: ogImage,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Gedung TULT, 8th Floor, Room TULT.08.09',
    addressLocality: 'Bandung',
    addressCountry: 'ID',
  },
  sameAs: site.socials
    .filter((social) => social.url.startsWith('http'))
    .map((social) => social.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} · Links | {site.institution}</title>
    <meta name="description" content={site.tagline} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#071312" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={`${site.name} · Links | ${site.institution}`} />
    <meta property="og:description" content={site.tagline} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${site.name} · Links | ${site.institution}`} />
    <meta name="twitter:description" content={site.tagline} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="min-h-dvh">
    <canvas
      id="binary-field"
      class="pointer-events-none fixed inset-0 z-0 h-full w-full"
      aria-hidden="true"></canvas>

    <main class="relative z-10 mx-auto w-full max-w-xl px-4 py-6 sm:py-10">
      <article
        class="relative rounded-[28px] border border-white/[0.07] bg-card px-4 pt-8 pb-7 shadow-[0_40px_90px_-50px_#000] sm:px-9 sm:pt-10 sm:pb-9"
      >
        <button
          type="button"
          data-share-open
          aria-haspopup="dialog"
          aria-controls="share-dialog"
          aria-label="Share this page"
          class="absolute top-2 right-2 z-20 inline-flex size-12 cursor-pointer items-center justify-center rounded-full text-ink-muted transition-colors duration-150 hover:bg-surface hover:text-ink focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none motion-reduce:transition-none sm:top-3 sm:right-3"
        >
          <Icon name="more-horizontal" class="size-5" />
        </button>

        <header class="flex flex-col items-center text-center">
          <div class="rounded-full border border-white/10 p-1">
            <img
              src="/assets/logo-icon.png"
              alt="EIM Lab emblem"
              width="76"
              height="76"
              fetchpriority="high"
              class="size-[76px] rounded-full bg-white object-contain p-2"
            />
          </div>

          <h1 class="mt-5 font-serif text-[2.75rem] leading-none text-ink sm:text-5xl">
            {site.name}
          </h1>
          <p
            class="mt-2 max-w-[18rem] font-mono text-[10px] leading-relaxed tracking-[0.18em] text-ink-muted uppercase"
          >
            {site.fullName}
          </p>

          <p class="mt-4 max-w-[21rem] text-pretty text-[15px] leading-relaxed text-ink-muted">
            {site.tagline}
          </p>

          <p class="mt-4 text-[12px] tracking-wide text-ink-muted">
            {site.institution} · Bandung
          </p>

          {
            site.socials.length > 0 && (
              <nav
                aria-label={`${site.name} social profiles`}
                class="mt-4 flex flex-wrap items-center justify-center gap-1"
              >
                {site.socials.map((social) => {
                  const isExternal = social.url.startsWith('http');
                  const label = social.label ?? socialLabels[social.platform];
                  return (
                    <a
                      href={social.url}
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noopener noreferrer' : undefined}
                      aria-label={
                        isExternal ? `${label} (opens in a new tab)` : label
                      }
                      class="inline-flex size-12 items-center justify-center rounded-full text-ink-muted transition-colors duration-150 hover:bg-surface hover:text-accent focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none motion-reduce:transition-none"
                    >
                      {social.iconImage ? (
                        <img
                          src={social.iconImage}
                          alt=""
                          width="40"
                          height="40"
                          loading="lazy"
                          decoding="async"
                          class="size-5 object-contain"
                        />
                      ) : social.platform === 'custom' ? (
                        social.customIcon ? (
                          <Icon name="custom" path={social.customIcon} class="size-5" />
                        ) : (
                          <span aria-hidden="true" class="text-[13px] font-medium">
                            {label.slice(0, 1).toUpperCase()}
                          </span>
                        )
                      ) : (
                        <Icon name={social.platform} class="size-5" />
                      )}
                    </a>
                  );
                })}
              </nav>
            )
          }
        </header>

        {
          site.featuredLinks.length > 0 && (
            <div class="mt-7 space-y-2.5">
              {site.featuredLinks.map((featured, index) => {
                const primary = index === 0;
                return (
                  <a
                    href={featured.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      'group grid min-h-15 grid-cols-[1.5rem_1fr_1.5rem] items-center gap-3 rounded-xl px-4 py-2.5 transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none motion-reduce:transition-none sm:px-5',
                      primary
                        ? 'bg-accent text-accent-ink hover:bg-accent-bright'
                        : 'bg-surface text-ink hover:bg-surface-hover',
                    ]}
                  >
                    <IconView
                      icon={featured.icon}
                      customIcon={featured.customIcon}
                      image={featured.iconImage}
                      class:list={['size-5', !primary && 'text-accent']}
                    />
                    <span class="truncate text-center text-base font-semibold">
                      {featured.label}
                    </span>
                    <Icon
                      name="arrow-up-right"
                      class:list={[
                        'size-[18px] justify-self-end transition-transform duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transition-none',
                        !primary && 'text-accent',
                      ]}
                    />
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                );
              })}
            </div>
          )
        }

        <nav aria-label="EIM Lab destinations" class="mt-9 space-y-7">
          {
            linkGroups.map((group, groupIndex) => {
              const id = `group-${group.title.toLowerCase().replace(/[^a-z]+/g, '-')}`;
              return (
                <section aria-labelledby={id}>
                  <h2
                    id={id}
                    class="flex items-center gap-3 font-mono text-[11px] tracking-[0.16em] text-ink-muted uppercase"
                  >
                    <span class="h-px flex-1 bg-line" aria-hidden="true" />
                    <span class="whitespace-nowrap">{group.title}</span>
                    <span class="h-px flex-1 bg-line" aria-hidden="true" />
                  </h2>
                  {group.layout === 'scroll' ? (
                    <LinkScroller group={group} labelledBy={id} priorityFirst={groupIndex === 0} />
                  ) : (
                    <div class="mt-3 space-y-2.5">
                      {group.links.map((link, linkIndex) => (
                        <LinkCard link={link} priority={groupIndex === 0 && linkIndex === 0} />
                      ))}
                    </div>
                  )}
                </section>
              );
            })
          }
        </nav>

        <footer class="mt-9 border-t border-line pt-6 text-center text-[12px] leading-relaxed text-ink-muted">
          <p>{site.address}</p>
          <p class="mt-1">{site.hours}</p>
          <p class="mt-4">{site.faculty}</p>
          <p>{site.institution}</p>
          <p class="mt-4">© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
        </footer>
      </article>

      <dialog
        id="share-dialog"
        data-share-dialog
        aria-labelledby="share-dialog-title"
        class="m-auto w-[calc(100%-2rem)] max-w-md overflow-hidden rounded-2xl border border-line bg-card p-0 text-ink shadow-[0_30px_80px_-20px_#000]"
      >
        <header class="flex items-center justify-between gap-3 px-4 pt-4 sm:px-5">
          <h2 id="share-dialog-title" class="font-serif text-2xl leading-none">Share EIM Lab</h2>
          <button
            type="button"
            data-share-close
            aria-label="Close share dialog"
            class="-my-1 -mr-1 inline-flex size-12 items-center justify-center rounded-full text-ink-muted transition-colors duration-150 hover:bg-surface hover:text-ink focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none motion-reduce:transition-none"
          >
            <Icon name="x" class="size-5" />
          </button>
        </header>

        <div
          class="mx-4 mt-3 flex flex-col items-center rounded-xl bg-accent px-6 py-6 text-center text-accent-ink sm:mx-5"
        >
          <img
            src="/assets/logo-icon.png"
            alt=""
            width="64"
            height="64"
            class="size-16 rounded-full bg-white object-contain p-1.5"
          />
          <p class="mt-3 font-serif text-3xl leading-none">EIM Lab</p>
          <p class="mt-1.5 text-[12px] text-accent-ink/75">{shareHost}</p>
        </div>

        <div class="flex flex-wrap justify-center gap-y-3 px-4 py-5 sm:px-5">
          <button
            type="button"
            data-copy-action
            class="group flex w-1/3 flex-col items-center gap-1.5 rounded-lg py-0.5 text-center focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none sm:w-1/6"
          >
            <span
              class="inline-flex size-12 items-center justify-center rounded-full bg-surface text-ink-muted transition-colors duration-150 group-hover:bg-surface-hover group-hover:text-accent group-focus-visible:text-accent motion-reduce:transition-none"
            >
              <Icon name="link" class="size-5" />
            </span>
            <span data-copy-label class="text-[11px] leading-tight text-ink-muted">Copy link</span>
          </button>

          <a
            data-share-target
            data-share-whatsapp
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex w-1/3 flex-col items-center gap-1.5 rounded-lg py-0.5 text-center focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none sm:w-1/6"
          >
            <span
              class="inline-flex size-12 items-center justify-center rounded-full bg-surface text-ink-muted transition-colors duration-150 group-hover:bg-surface-hover group-hover:text-accent motion-reduce:transition-none"
            >
              <Icon name="message-circle" class="size-5" />
            </span>
            <span class="text-[11px] leading-tight text-ink-muted">WhatsApp</span>
          </a>

          <a
            data-share-target
            data-share-x
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex w-1/3 flex-col items-center gap-1.5 rounded-lg py-0.5 text-center focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none sm:w-1/6"
          >
            <span
              class="inline-flex size-12 items-center justify-center rounded-full bg-surface text-ink-muted transition-colors duration-150 group-hover:bg-surface-hover group-hover:text-accent motion-reduce:transition-none"
            >
              <Icon name="x-twitter" class="size-5" />
            </span>
            <span class="text-[11px] leading-tight text-ink-muted">X</span>
          </a>

          <a
            data-share-target
            data-share-linkedin
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex w-1/3 flex-col items-center gap-1.5 rounded-lg py-0.5 text-center focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none sm:w-1/6"
          >
            <span
              class="inline-flex size-12 items-center justify-center rounded-full bg-surface text-ink-muted transition-colors duration-150 group-hover:bg-surface-hover group-hover:text-accent motion-reduce:transition-none"
            >
              <Icon name="linkedin" class="size-5" />
            </span>
            <span class="text-[11px] leading-tight text-ink-muted">LinkedIn</span>
          </a>

          <a
            data-share-target
            data-share-email
            href="#"
            class="group flex w-1/3 flex-col items-center gap-1.5 rounded-lg py-0.5 text-center focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none sm:w-1/6"
          >
            <span
              class="inline-flex size-12 items-center justify-center rounded-full bg-surface text-ink-muted transition-colors duration-150 group-hover:bg-surface-hover group-hover:text-accent motion-reduce:transition-none"
            >
              <Icon name="mail" class="size-5" />
            </span>
            <span class="text-[11px] leading-tight text-ink-muted">Email</span>
          </a>

          <button
            type="button"
            data-share-native
            hidden
            class="group w-1/3 flex-col items-center gap-1.5 rounded-lg py-0.5 text-center focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none sm:w-1/6"
          >
            <span
              class="inline-flex size-12 items-center justify-center rounded-full bg-surface text-ink-muted transition-colors duration-150 group-hover:bg-surface-hover group-hover:text-accent motion-reduce:transition-none"
            >
              <Icon name="share" class="size-5" />
            </span>
            <span class="text-[11px] leading-tight text-ink-muted">More</span>
          </button>
        </div>

        <p class="sr-only" role="status" data-share-status></p>
      </dialog>
    </main>

    <script>
      const shareDialog = document.querySelector<HTMLDialogElement>('[data-share-dialog]');
      const shareTrigger = document.querySelector<HTMLButtonElement>('[data-share-open]');

      if (shareDialog && shareTrigger) {
        const closeButton = shareDialog.querySelector<HTMLButtonElement>('[data-share-close]');
        const copyButton = shareDialog.querySelector<HTMLButtonElement>('[data-copy-action]');
        const copyLabel = shareDialog.querySelector<HTMLElement>('[data-copy-label]');
        const status = shareDialog.querySelector<HTMLElement>('[data-share-status]');
        const nativeButton = shareDialog.querySelector<HTMLButtonElement>('[data-share-native]');
        const pageUrl = window.location.href;
        const pageTitle = document.title;
        const encodedUrl = encodeURIComponent(pageUrl);
        const encodedTitle = encodeURIComponent(pageTitle);

        const setHref = (selector: string, href: string) => {
          const link = shareDialog.querySelector<HTMLAnchorElement>(selector);
          if (link) link.href = href;
        };

        setHref(
          '[data-share-whatsapp]',
          `https://wa.me/?text=${encodeURIComponent(`${pageTitle} ${pageUrl}`)}`
        );
        setHref(
          '[data-share-x]',
          `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`
        );
        setHref(
          '[data-share-linkedin]',
          `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`
        );
        setHref('[data-share-email]', `mailto:?subject=${encodedTitle}&body=${encodedUrl}`);

        if (nativeButton && typeof navigator.share === 'function') {
          nativeButton.hidden = false;
          nativeButton.classList.add('flex');
        }

        const announce = (message: string) => {
          if (status) status.textContent = message;
        };

        const lockScroll = (locked: boolean) => {
          document.documentElement.style.overflow = locked ? 'hidden' : '';
        };

        const close = () => shareDialog.close();

        const copyLink = async () => {
          try {
            await navigator.clipboard.writeText(pageUrl);
            announce('Link copied to clipboard');
            if (copyLabel) {
              copyLabel.textContent = 'Copied';
              window.setTimeout(() => {
                copyLabel.textContent = 'Copy link';
              }, 1600);
            }
          } catch {
            announce('Could not copy the link');
          }
        };

        shareTrigger.addEventListener('click', () => {
          shareDialog.showModal();
          lockScroll(true);
        });

        closeButton?.addEventListener('click', close);

        shareDialog.addEventListener('close', () => {
          lockScroll(false);
          shareTrigger.focus();
        });

        shareDialog.addEventListener('click', (event) => {
          if (event.target !== shareDialog) return;
          const rect = shareDialog.getBoundingClientRect();
          const outside =
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom;
          if (outside) close();
        });

        shareDialog.querySelectorAll<HTMLAnchorElement>('[data-share-target]').forEach((target) => {
          target.addEventListener('click', close);
        });

        copyButton?.addEventListener('click', copyLink);

        nativeButton?.addEventListener('click', async () => {
          if (!navigator.share) return;
          try {
            await navigator.share({ title: pageTitle, url: pageUrl });
            close();
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
            await copyLink();
          }
        });
      }
    </script>

    <script>
      const field = document.getElementById('binary-field');
      const surface = field instanceof HTMLCanvasElement ? field : null;
      const context = surface?.getContext('2d') ?? null;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (surface && context) {
        const canvas = surface;
        const ctx = context;
        type Bit = {
          x: number;
          y: number;
          char: '0' | '1';
          speed: number;
          sway: number;
          phase: number;
          fill: string;
        };

        let bits: Bit[] = [];
        let width = 0;
        let height = 0;
        let frameId = 0;
        let last = 0;

        const seed = (count: number): Bit[] =>
          Array.from({ length: count }, () => {
            const teal = Math.random() > 0.22;
            const alpha = (teal ? 0.06 + Math.random() * 0.13 : 0.04 + Math.random() * 0.08).toFixed(3);
            return {
              x: Math.random() * width,
              y: Math.random() * height,
              char: Math.random() > 0.5 ? '1' : '0',
              speed: 4 + Math.random() * 10,
              sway: 0.2 + Math.random() * 0.8,
              phase: Math.random() * Math.PI * 2,
              fill: teal ? `rgba(61, 214, 195, ${alpha})` : `rgba(242, 240, 234, ${alpha})`,
            };
          });

        function paint(time: number) {
          ctx.clearRect(0, 0, width, height);
          ctx.font = '13px "IBM Plex Mono", ui-monospace, monospace';
          ctx.textAlign = 'center';
          for (const bit of bits) {
            const x = bit.x + Math.sin(time * 0.00035 + bit.phase) * 9 * bit.sway;
            ctx.fillStyle = bit.fill;
            ctx.fillText(bit.char, x, bit.y);
          }
        }

        function frame(now: number) {
          const dt = last ? Math.min((now - last) / 1000, 0.05) : 0;
          last = now;
          for (const bit of bits) {
            bit.y -= bit.speed * dt;
            if (bit.y < -20) {
              bit.y = height + 20;
              bit.x = Math.random() * width;
            }
          }
          paint(now);
          frameId = requestAnimationFrame(frame);
        }

        function resize() {
          width = window.innerWidth;
          height = window.innerHeight;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.round(width * dpr);
          canvas.height = Math.round(height * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          bits = seed(Math.min(150, Math.max(36, Math.round((width * height) / 9000))));
          if (reduceMotion.matches) paint(0);
        }

        function sync() {
          cancelAnimationFrame(frameId);
          last = 0;
          if (reduceMotion.matches) {
            paint(0);
          } else {
            frameId = requestAnimationFrame(frame);
          }
        }

        resize();
        sync();
        window.addEventListener('resize', () => {
          resize();
          sync();
        });
        reduceMotion.addEventListener('change', sync);
      }
    </script>
  </body>
</html>
