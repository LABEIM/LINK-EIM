---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import LinkCard from '../components/LinkCard.astro';
import { site, linkGroups } from '../data/site';

const siteUrl = Astro.site ?? new URL('https://link.eimlab.org');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/assets/logo-icon.png', siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Enterprise Infrastructure Management (EIM) Research Laboratory',
  alternateName: site.name,
  url: site.labUrl,
  logo: ogImage,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Gedung TULT, 8th Floor, Room TULT.08.09',
    addressLocality: 'Bandung',
    addressCountry: 'ID',
  },
  sameAs: [site.socials.instagram, site.socials.linkedin, site.socials.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EIM Lab · Links | Telkom University</title>
    <meta name="description" content={site.tagline} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a0a0b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EIM Lab" />
    <meta property="og:title" content="EIM Lab · Links | Telkom University" />
    <meta property="og:description" content={site.tagline} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="EIM Lab · Links | Telkom University" />
    <meta name="twitter:description" content={site.tagline} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="min-h-dvh">
    <main class="relative z-10 mx-auto w-full max-w-md px-4 py-6 sm:py-10">
      <article
        class="rounded-[28px] border border-white/[0.07] bg-card px-4 pt-8 pb-7 shadow-[0_40px_90px_-50px_#000] sm:px-7"
      >
        <header class="flex flex-col items-center text-center">
          <div class="rounded-full border border-white/10 p-1">
            <img
              src="/assets/logo-icon.png"
              alt="EIM Lab emblem"
              width="76"
              height="76"
              fetchpriority="high"
              class="size-[76px] rounded-full bg-white object-contain p-2"
            />
          </div>

          <h1 class="mt-5 font-serif text-[2.75rem] leading-none text-ink">EIM Lab</h1>
          <p
            class="mt-2 max-w-[18rem] font-mono text-[10px] leading-relaxed tracking-[0.18em] text-ink-muted uppercase"
          >
            {site.fullName}
          </p>

          <p class="mt-4 max-w-[19rem] text-pretty text-[15px] leading-relaxed text-ink-muted">
            {site.tagline}
          </p>

          <p class="mt-4 text-[12px] tracking-wide text-ink-muted">
            {site.institution} · Bandung
          </p>

          <a
            href={site.status.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex min-h-11 max-w-full items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 font-mono text-[10px] tracking-[0.1em] whitespace-nowrap text-ink-muted uppercase transition-colors duration-150 hover:border-accent/40 hover:text-accent focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none motion-reduce:transition-none"
          >
            <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
            {site.status.label}
            <Icon name="arrow-up-right" class="size-3" />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </header>

        <a
          href={site.featuredLink.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-7 grid min-h-14 grid-cols-[1.25rem_1fr_1.25rem] items-center gap-3 rounded-xl bg-accent px-4 py-2.5 text-accent-ink transition-colors duration-150 hover:bg-accent-bright focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none motion-reduce:transition-none"
        >
          <Icon name="globe" class="size-[18px]" />
          <span class="truncate text-center text-[15px] font-semibold">
            {site.featuredLink.label}
          </span>
          <Icon
            name="arrow-up-right"
            class="size-4 justify-self-end transition-transform duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transition-none"
          />
          <span class="sr-only">(opens in a new tab)</span>
        </a>

        <nav aria-label="EIM Lab destinations" class="mt-9 space-y-7">
          {
            linkGroups.map((group) => {
              const id = `group-${group.title.toLowerCase().replace(/[^a-z]+/g, '-')}`;
              return (
                <section aria-labelledby={id}>
                  <h2
                    id={id}
                    class="flex items-center gap-3 font-mono text-[10px] tracking-[0.18em] text-ink-muted uppercase"
                  >
                    <span class="h-px flex-1 bg-line" aria-hidden="true" />
                    <span class="whitespace-nowrap">{group.title}</span>
                    <span class="h-px flex-1 bg-line" aria-hidden="true" />
                  </h2>
                  <div class="mt-3 space-y-2.5">
                    {group.links.map((link) => (
                      <LinkCard link={link} />
                    ))}
                  </div>
                </section>
              );
            })
          }
        </nav>

        <footer class="mt-9 border-t border-line pt-6 text-center text-[11px] leading-relaxed text-ink-muted">
          <p>{site.address}</p>
          <p class="mt-1">{site.hours}</p>
          <p class="mt-4">{site.faculty}</p>
          <p>{site.institution}</p>
          <p class="mt-4">© 2026 EIM Lab. All rights reserved.</p>
        </footer>
      </article>
    </main>
  </body>
</html>
