---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import LinkCard from '../components/LinkCard.astro';
import LinkScroller from '../components/LinkScroller.astro';
import { site, linkGroups, type IconName } from '../data/site';

const siteUrl = Astro.site ?? new URL('https://link.eimlab.org');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/assets/logo-icon.png', siteUrl).href;

const socialLinks: { label: string; href: string; icon: IconName }[] = [
  { label: 'Instagram', href: site.socials.instagram, icon: 'instagram' },
  { label: 'LinkedIn', href: site.socials.linkedin, icon: 'linkedin' },
  { label: 'GitHub', href: site.socials.github, icon: 'github' },
  { label: 'Email the lab', href: `mailto:${site.email}`, icon: 'mail' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Enterprise Infrastructure Management (EIM) Research Laboratory',
  alternateName: site.name,
  url: site.labUrl,
  logo: ogImage,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Gedung TULT, 8th Floor, Room TULT.08.09',
    addressLocality: 'Bandung',
    addressCountry: 'ID',
  },
  sameAs: [site.socials.instagram, site.socials.linkedin, site.socials.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EIM Lab · Links | Telkom University</title>
    <meta name="description" content={site.tagline} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#071312" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EIM Lab" />
    <meta property="og:title" content="EIM Lab · Links | Telkom University" />
    <meta property="og:description" content={site.tagline} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="EIM Lab · Links | Telkom University" />
    <meta name="twitter:description" content={site.tagline} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="min-h-dvh">
    <canvas
      id="binary-field"
      class="pointer-events-none fixed inset-0 z-0 h-full w-full"
      aria-hidden="true"></canvas>

    <main class="relative z-10 mx-auto w-full max-w-xl px-4 py-6 sm:py-10">
      <article
        class="relative rounded-[28px] border border-white/[0.07] bg-card px-4 pt-8 pb-7 shadow-[0_40px_90px_-50px_#000] sm:px-9 sm:pt-10 sm:pb-9"
      >
        <details class="absolute top-2 right-2 z-20 sm:top-3 sm:right-3" data-share>
          <summary
            aria-label="Share this page"
            class="inline-flex size-12 cursor-pointer list-none items-center justify-center rounded-full text-ink-muted transition-colors duration-150 hover:bg-surface hover:text-ink focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none motion-reduce:transition-none [&::-webkit-details-marker]:hidden"
          >
            <Icon name="more-horizontal" class="size-5" />
          </summary>
          <div
            class="absolute top-full right-0 mt-1 w-44 rounded-xl border border-line bg-surface p-1.5 shadow-[0_18px_40px_-20px_#000]"
          >
            <button
              type="button"
              data-share-action
              class="flex min-h-12 w-full items-center gap-2.5 rounded-lg px-3 text-left text-sm text-ink transition-colors duration-150 hover:bg-surface-hover focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none motion-reduce:transition-none"
            >
              <Icon name="share" class="size-4 text-ink-muted" />
              Share link
            </button>
            <button
              type="button"
              data-copy-action
              class="flex min-h-12 w-full items-center gap-2.5 rounded-lg px-3 text-left text-sm text-ink transition-colors duration-150 hover:bg-surface-hover focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none motion-reduce:transition-none"
            >
              <Icon name="link" class="size-4 text-ink-muted" />
              <span data-copy-label>Copy link</span>
            </button>
          </div>
        </details>

        <header class="flex flex-col items-center text-center">
          <div class="rounded-full border border-white/10 p-1">
            <img
              src="/assets/logo-icon.png"
              alt="EIM Lab emblem"
              width="76"
              height="76"
              fetchpriority="high"
              class="size-[76px] rounded-full bg-white object-contain p-2"
            />
          </div>

          <h1 class="mt-5 font-serif text-[2.75rem] leading-none text-ink sm:text-5xl">EIM Lab</h1>
          <p
            class="mt-2 max-w-[18rem] font-mono text-[10px] leading-relaxed tracking-[0.18em] text-ink-muted uppercase"
          >
            {site.fullName}
          </p>

          <p class="mt-4 max-w-[21rem] text-pretty text-[15px] leading-relaxed text-ink-muted">
            {site.tagline}
          </p>

          <p class="mt-4 text-[12px] tracking-wide text-ink-muted">
            {site.institution} · Bandung
          </p>

          <nav aria-label="EIM Lab social profiles" class="mt-4 flex items-center justify-center gap-1">
            {
              socialLinks.map((social) => {
                const isExternal = social.href.startsWith('http');
                return (
                  <a
                    href={social.href}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    aria-label={
                      isExternal ? `${social.label} (opens in a new tab)` : social.label
                    }
                    class="inline-flex size-12 items-center justify-center rounded-full text-ink-muted transition-colors duration-150 hover:bg-surface hover:text-accent focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none motion-reduce:transition-none"
                  >
                    <Icon name={social.icon} class="size-5" />
                  </a>
                );
              })
            }
          </nav>
        </header>

        <a
          href={site.featuredLink.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-7 grid min-h-15 grid-cols-[1.5rem_1fr_1.5rem] items-center gap-3 rounded-xl bg-accent px-4 py-2.5 text-accent-ink transition-colors duration-150 hover:bg-accent-bright focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none motion-reduce:transition-none sm:px-5"
        >
          <Icon name={site.featuredLink.icon} class="size-5" />
          <span class="truncate text-center text-base font-semibold">
            {site.featuredLink.label}
          </span>
          <Icon
            name="arrow-up-right"
            class="size-[18px] justify-self-end transition-transform duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transition-none"
          />
          <span class="sr-only">(opens in a new tab)</span>
        </a>

        <nav aria-label="EIM Lab destinations" class="mt-9 space-y-7">
          {
            linkGroups.map((group, groupIndex) => {
              const id = `group-${group.title.toLowerCase().replace(/[^a-z]+/g, '-')}`;
              return (
                <section aria-labelledby={id}>
                  <h2
                    id={id}
                    class="flex items-center gap-3 font-mono text-[11px] tracking-[0.16em] text-ink-muted uppercase"
                  >
                    <span class="h-px flex-1 bg-line" aria-hidden="true" />
                    <span class="whitespace-nowrap">{group.title}</span>
                    <span class="h-px flex-1 bg-line" aria-hidden="true" />
                  </h2>
                  {group.layout === 'scroll' ? (
                    <LinkScroller group={group} labelledBy={id} priorityFirst={groupIndex === 0} />
                  ) : (
                    <div class="mt-3 space-y-2.5">
                      {group.links.map((link, linkIndex) => (
                        <LinkCard link={link} priority={groupIndex === 0 && linkIndex === 0} />
                      ))}
                    </div>
                  )}
                </section>
              );
            })
          }
        </nav>

        <footer class="mt-9 border-t border-line pt-6 text-center text-[12px] leading-relaxed text-ink-muted">
          <p>{site.address}</p>
          <p class="mt-1">{site.hours}</p>
          <p class="mt-4">{site.faculty}</p>
          <p>{site.institution}</p>
          <p class="mt-4">© 2026 EIM Lab. All rights reserved.</p>
        </footer>

        <p class="sr-only" role="status" data-share-status></p>
      </article>
    </main>

    <script>
      const shareRoot = document.querySelector<HTMLDetailsElement>('[data-share]');

      if (shareRoot) {
        const summary = shareRoot.querySelector<HTMLElement>('summary');
        const shareButton = shareRoot.querySelector<HTMLButtonElement>('[data-share-action]');
        const copyButton = shareRoot.querySelector<HTMLButtonElement>('[data-copy-action]');
        const copyLabel = shareRoot.querySelector<HTMLElement>('[data-copy-label]');
        const status = document.querySelector<HTMLElement>('[data-share-status]');
        const shareData = { title: document.title, url: window.location.href };

        const announce = (message: string) => {
          if (status) status.textContent = message;
        };

        const close = (restoreFocus = false) => {
          shareRoot.open = false;
          if (restoreFocus) summary?.focus();
        };

        const copyLink = async () => {
          try {
            await navigator.clipboard.writeText(shareData.url);
            announce('Link copied to clipboard');
            if (copyLabel) {
              copyLabel.textContent = 'Copied';
              window.setTimeout(() => {
                copyLabel.textContent = 'Copy link';
              }, 1600);
            }
          } catch {
            announce('Could not copy the link');
          }
        };

        shareButton?.addEventListener('click', async () => {
          if (navigator.share) {
            try {
              await navigator.share(shareData);
              close(true);
            } catch (error) {
              if (error instanceof DOMException && error.name === 'AbortError') return;
              await copyLink();
            }
          } else {
            await copyLink();
          }
        });

        copyButton?.addEventListener('click', copyLink);

        document.addEventListener('click', (event) => {
          if (shareRoot.open && !shareRoot.contains(event.target as Node)) close();
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && shareRoot.open) close(true);
        });
      }
    </script>

    <script>
      const field = document.getElementById('binary-field');
      const surface = field instanceof HTMLCanvasElement ? field : null;
      const context = surface?.getContext('2d') ?? null;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (surface && context) {
        const canvas = surface;
        const ctx = context;
        type Bit = {
          x: number;
          y: number;
          char: '0' | '1';
          speed: number;
          sway: number;
          phase: number;
          fill: string;
        };

        let bits: Bit[] = [];
        let width = 0;
        let height = 0;
        let frameId = 0;
        let last = 0;

        const seed = (count: number): Bit[] =>
          Array.from({ length: count }, () => {
            const teal = Math.random() > 0.22;
            const alpha = (teal ? 0.06 + Math.random() * 0.13 : 0.04 + Math.random() * 0.08).toFixed(3);
            return {
              x: Math.random() * width,
              y: Math.random() * height,
              char: Math.random() > 0.5 ? '1' : '0',
              speed: 4 + Math.random() * 10,
              sway: 0.2 + Math.random() * 0.8,
              phase: Math.random() * Math.PI * 2,
              fill: teal ? `rgba(61, 214, 195, ${alpha})` : `rgba(242, 240, 234, ${alpha})`,
            };
          });

        function paint(time: number) {
          ctx.clearRect(0, 0, width, height);
          ctx.font = '13px "IBM Plex Mono", ui-monospace, monospace';
          ctx.textAlign = 'center';
          for (const bit of bits) {
            const x = bit.x + Math.sin(time * 0.00035 + bit.phase) * 9 * bit.sway;
            ctx.fillStyle = bit.fill;
            ctx.fillText(bit.char, x, bit.y);
          }
        }

        function frame(now: number) {
          const dt = last ? Math.min((now - last) / 1000, 0.05) : 0;
          last = now;
          for (const bit of bits) {
            bit.y -= bit.speed * dt;
            if (bit.y < -20) {
              bit.y = height + 20;
              bit.x = Math.random() * width;
            }
          }
          paint(now);
          frameId = requestAnimationFrame(frame);
        }

        function resize() {
          width = window.innerWidth;
          height = window.innerHeight;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.round(width * dpr);
          canvas.height = Math.round(height * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          bits = seed(Math.min(150, Math.max(36, Math.round((width * height) / 9000))));
          if (reduceMotion.matches) paint(0);
        }

        function sync() {
          cancelAnimationFrame(frameId);
          last = 0;
          if (reduceMotion.matches) {
            paint(0);
          } else {
            frameId = requestAnimationFrame(frame);
          }
        }

        resize();
        sync();
        window.addEventListener('resize', () => {
          resize();
          sync();
        });
        reduceMotion.addEventListener('change', sync);
      }
    </script>
  </body>
</html>
