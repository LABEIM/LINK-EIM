---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import LinkCard from '../components/LinkCard.astro';
import { site, linkGroups } from '../data/site';

const siteUrl = Astro.site ?? new URL('https://link.eimlab.org');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/assets/logo-icon.png', siteUrl).href;
const pad = (value: number) => String(value).padStart(2, '0');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Enterprise Infrastructure Management (EIM) Research Laboratory',
  alternateName: site.name,
  url: site.labUrl,
  logo: ogImage,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Gedung TULT, 8th Floor, Room TULT.08.09',
    addressLocality: 'Bandung',
    addressCountry: 'ID',
  },
  sameAs: [site.socials.instagram, site.socials.linkedin, site.socials.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EIM Lab · Links | Telkom University</title>
    <meta name="description" content={site.tagline} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EIM Lab" />
    <meta property="og:title" content="EIM Lab · Links | Telkom University" />
    <meta property="og:description" content={site.tagline} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="EIM Lab · Links | Telkom University" />
    <meta name="twitter:description" content={site.tagline} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="min-h-dvh">
    <main class="mx-auto w-full max-w-md px-5 pt-8 pb-12 sm:pt-12">
      <header>
        <div class="flex items-start gap-4">
          <img
            src="/assets/logo-icon.png"
            alt="EIM Lab emblem"
            width="48"
            height="48"
            fetchpriority="high"
            class="mt-0.5 size-12 shrink-0 border border-line bg-white object-contain p-1"
          />
          <div class="min-w-0">
            <p
              class="font-mono text-[10px] tracking-[0.18em] text-ink-muted uppercase"
            >
              Research Laboratory
            </p>
            <h1
              class="mt-1 text-[2.5rem] leading-none font-semibold tracking-[-0.04em] text-ink sm:text-[2.75rem]"
            >
              EIM Lab
            </h1>
          </div>
        </div>

        <p class="mt-6 max-w-[26rem] text-base leading-relaxed text-pretty text-ink-muted">
          {site.tagline}
        </p>

        <div class="mt-5 border-t border-line pt-4">
          <p class="font-mono text-[11px] leading-relaxed text-ink-muted">
            {site.fullName}<br />
            Telkom University · S1 Information Systems<br />
            School of Industrial Engineering · Bandung
          </p>
        </div>

        <a
          href={site.status.href}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex min-h-11 items-center gap-2.5 border border-accent/40 px-3 font-mono text-[11px] tracking-[0.12em] text-accent uppercase transition-colors duration-150 hover:bg-accent hover:text-canvas focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas focus-visible:outline-none motion-reduce:transition-none"
        >
          <span class="size-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
          {site.status.label}
          <Icon name="arrow-up-right" class="size-3.5" />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </header>

      <a
        href={site.featuredLink.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group mt-7 flex min-h-14 items-center justify-between gap-4 bg-ink px-4 text-canvas transition-colors duration-150 hover:bg-accent focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas focus-visible:outline-none motion-reduce:transition-none"
      >
        <span class="flex items-center gap-2.5 text-[15px] font-semibold tracking-[-0.01em]">
          <Icon name="globe" class="size-[18px]" />
          {site.featuredLink.label}
        </span>
        <Icon
          name="arrow-up-right"
          class="size-4 transition-transform duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transition-none"
        />
        <span class="sr-only">(opens in a new tab)</span>
      </a>

      <nav aria-label="EIM Lab destinations" class="mt-10">
        {
          linkGroups.map((group, index) => {
            const id = `group-${group.title.toLowerCase().replace(/[^a-z]+/g, '-')}`;
            return (
              <section class="mb-9 last:mb-0" aria-labelledby={id}>
                <div class="flex items-baseline justify-between gap-4 border-b border-line pb-2">
                  <h2
                    id={id}
                    class="font-mono text-[11px] tracking-[0.16em] text-ink-muted uppercase"
                  >
                    <span class="text-accent">{pad(index + 1)}</span>
                    <span class="mx-2 text-line">/</span>
                    {group.title}
                  </h2>
                  <span class="font-mono text-[10px] text-ink-muted">
                    {pad(group.links.length)}
                  </span>
                </div>
                <div>
                  {group.links.map((link) => (
                    <LinkCard link={link} />
                  ))}
                </div>
              </section>
            );
          })
        }
      </nav>

      <footer class="mt-10 border-t border-line pt-6 font-mono text-[11px] leading-relaxed text-ink-muted">
        <p>Gedung TULT, 8th Floor, Room TULT.08.09</p>
        <p>Bandung, Indonesia</p>
        <p class="mt-3">Monday–Friday · 08.00–17.00 WIB</p>
        <p class="mt-5">S1 Information Systems · School of Industrial Engineering (FRI)</p>
        <p>Telkom University</p>
        <p class="mt-3">© 2026 EIM Lab. All rights reserved.</p>
      </footer>
    </main>
  </body>
</html>
